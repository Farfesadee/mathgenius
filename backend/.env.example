# Backend environment template
# Copy this to .env and fill in your actual values
# NEVER commit .env to git

# Groq LLM API
GROQ_API_KEY=your_groq_api_key_here

# App Config
APP_NAME=MathGenius
ENVIRONMENT=development

# Supabase (use service role key, NEVER expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Optional: Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Optional: Logging
LOG_LEVEL=INFO

# Welcome / transactional email via cPanel mailbox (required for welcome emails)
SMTP_HOST=mathgenius.guru
SMTP_PORT=465
SMTP_USER=noreply@mathgenius.guru
SMTP_PASSWORD=your_mailbox_password_here
# Optional: overrides (defaults shown)
# SMTP_FROM_NAME=MathGenius
# SMTP_FROM_EMAIL=noreply@mathgenius.guru
# SMTP_REPLY_TO=help@mathgenius.guru
# FRONTEND_URL=https://mathgenius.guru
# Flagged-question alerts go here:
# ADMIN_EMAIL=help@mathgenius.guru
